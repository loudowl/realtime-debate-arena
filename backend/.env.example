PORT=5000
DATABASE_URL=postgres://user:password@localhost:5432/debatearena
REDIS_URL=redis://localhost:6379
OPENAI_API_KEY=your-openai-api-key

# --- Observer Mode (livestream fact-checking) ---
# Force the synthetic transcript pipeline even if ffmpeg/yt-dlp/keys exist.
# Useful for local demos with zero external dependencies.
OBSERVER_SIMULATION=true
# Model used for audio transcription on the real ingestion path.
TRANSCRIPTION_MODEL=whisper-1
# Seconds of audio per transcription window.
OBSERVER_WINDOW_SECONDS=5
# Optional explicit paths if ffmpeg / yt-dlp are not on PATH.
FFMPEG_PATH=ffmpeg
YTDLP_PATH=yt-dlp

# --- Multi-model moderators (parallel bias comparison) ---
# When false (default), moderators use deterministic, persona-specific
# simulation so the full fact-check + scoring + report pipeline runs with zero
# API keys. Set to "true" to call the real provider APIs (per available keys).
MODERATOR_SIMULATION=false
# Provider API keys (only needed when MODERATOR_SIMULATION=true). Any subset
# works; models without a key fall back to simulation individually.
# OPENAI_API_KEY is already defined above and powers the OpenAI moderator.
ANTHROPIC_API_KEY=
XAI_API_KEY=
GOOGLE_API_KEY=
# Optional model overrides.
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GROK_MODEL=grok-2-latest
GEMINI_MODEL=gemini-1.5-pro
XAI_BASE_URL=https://api.x.ai/v1
